# ── Database (required) ──────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Session (required in production) ─────────────────
SESSION_SECRET=change-me-to-a-random-secret-in-production

# ── Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Email (optional — invites will print links to console if not set)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── App URL (optional — used for invite links) ───────
APP_BASE_URL=http://localhost:5000

# ── Payment integration (optional) ───────────────────
EXTERNAL_PAYMENT_API_URL=
EXTERNAL_PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ── Storage safety ───────────────────────────────────
# Set to "true" ONLY for local development without a database
ALLOW_MEMORY_STORAGE=false

# ── BytHub console (least-privilege database roles) ──────────────────────────
# Created by migrations/001_console_hardening.sql. Leave both unset and the
# console reports itself as unconfigured rather than falling back to the main,
# owner-privileged credentials.
#   console_ro — SELECT on the redacted `console` schema, read-only transactions
#   console_rw — DML on public, no DDL, reachable only via break-glass elevation
CONSOLE_RO_DATABASE_URL=
CONSOLE_RW_DATABASE_URL=
